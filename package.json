{
  "name": "webxdc-widget",
  "version": "0.1.7",
  "description": "A Matrix widget that plays webxdc apps in a room: add them from the webxdc.org catalog, a file or a URL, run them network-isolated, sync their updates through the room",
  "private": true,
  "type": "module",
  "author": "Yan Minagawa",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "VITE_RUNNER_URL=http://127.0.0.1:4186/ pnpm build && playwright test",
    "release:store": "node scripts/release-to-store.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "matrix-widget-api": "^1.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
